{
  "name": "charting-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && npm run validate:bundle",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:bundle": "python ../scripts/validate_frontend_bundle.py --dist-dir dist",
    "validate:migration": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.45.1",
    "framer-motion": "^12.35.2",
    "lightweight-charts": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vitest": "^1.6.0"
  }
}
