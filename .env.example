# Safe local template. Copy to .env and fill values locally.
APP_ENV=dev
APP_NAME=cvingtrade25x
PORT=5055

ORACLE_USER=CVING_APP
ORACLE_PASSWORD=replace-with-local-secret
ORACLE_DSN=127.0.0.1:1521/cvingpdb.local
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=cvingpdb.local
ORACLE_SCHEMA=
ORACLE_TABLE=NSE_NIFTY500_DAILY_RAW_DATA_DEV

CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,null
VITE_API_BASE_URL=
VITE_CHART_API_BASE_URL=
VITE_LEGACY_API_BASE_URL=

# Read-only MCP. Localhost is the fail-closed default.
CVING_MCP_PROFILE=local-http
CVING_MCP_HOST=127.0.0.1
CVING_MCP_PORT=1729
CVING_MCP_PATH=/mcp
CVING_MCP_PUBLIC_BASE_URL=
CVING_MCP_AUTH_MODE=bearer
CVING_MCP_ALLOW_PUBLIC_NOAUTH_TEST=false
CVING_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CVING_MCP_ALLOWED_ORIGINS=
CVING_MCP_TRUST_PROXY=false
CVING_MCP_TRUSTED_PROXIES=
CVING_MCP_RATE_LIMIT_PER_MINUTE=60
CVING_MCP_MAX_CONCURRENT_REQUESTS=10
CVING_MCP_MAX_REQUEST_BODY_BYTES=1048576
CVING_MCP_MAX_RESPONSE_BYTES=1048576
CVING_MCP_TOOL_TIMEOUT_SECONDS=30
CVING_MCP_MAX_BARS=2000
CVING_SCAN_MAX_UNIVERSE=500
CVING_SCAN_MAX_RESULTS=50
CVING_SCAN_WORKERS=4
CVING_MCP_CACHE_TTL_SECONDS=30
CVING_MCP_ALLOW_REMOTE=0
CVING_MCP_BEARER_TOKEN=
CVING_MCP_DB_QUERY_TIMEOUT_MS=15000
CVING_MCP_ORACLE_CIRCUIT_FAILURES=3
CVING_MCP_ORACLE_CIRCUIT_RESET_SECONDS=30
CVING_MCP_ALLOWED_EXCHANGES=NSE
CVING_MCP_ALLOWED_TOOLS=
CVING_MCP_SYMBOL_ALLOWLIST=
CVING_MCP_SYMBOL_DENYLIST=
# External OAuth/OIDC provider integration (AUTH_MODE=oauth only).
CVING_MCP_OAUTH_ISSUER_URL=
CVING_MCP_OAUTH_RESOURCE_URL=
CVING_MCP_OAUTH_INTROSPECTION_URL=
CVING_MCP_OAUTH_CLIENT_ID=
CVING_MCP_OAUTH_CLIENT_SECRET=
CVING_MCP_OAUTH_EXPECTED_AUDIENCE=
CVING_MCP_LOG_LEVEL=INFO

# Optional free, temporary Cloudflare Quick Tunnel. Runtime URL/PID/log files
# remain under ignored .runtime/ and never contain bearer/OAuth/Oracle secrets.
CVING_QUICK_TUNNEL_ENABLED=false
CVING_QUICK_TUNNEL_PROVIDER=cloudflare
CVING_QUICK_TUNNEL_ORIGIN=http://127.0.0.1:1729
CVING_QUICK_TUNNEL_BASE_URL_FILE=runtime/mcp/public_url.txt
CVING_QUICK_TUNNEL_PUBLIC_URL_FILE=runtime/mcp/remote_mcp_url.txt
CVING_QUICK_TUNNEL_STARTED_AT_FILE=runtime/mcp/tunnel_started_at.txt
CVING_QUICK_TUNNEL_METADATA_FILE=runtime/mcp/remote_mcp.json
CVING_QUICK_TUNNEL_LOG_FILE=runtime/logs/cloudflare_mcp.log
CVING_QUICK_TUNNEL_PID_FILE=runtime/mcp/cloudflared.pid
CVING_QUICK_TUNNEL_STARTUP_TIMEOUT_SECONDS=30

# Sector Rotation V3 is opt-in. Keep v2 for the existing production page.
SECTOR_ROTATION_ENGINE_VERSION=v2
VITE_SECTOR_ROTATION_VERSION=v2

# Managed MCP lifecycle (explicit named tunnel requires operator-owned hostname).
# Existing .env is never overwritten. Legacy QUICK_TUNNEL_ENABLED remains fallback.
CVING_CLOUDFLARE_MODE=named
CVING_MCP_PUBLIC_HOST=
CVING_MCP_PUBLIC_URL=
CVING_CLOUDFLARE_TUNNEL_ID=
CVING_CLOUDFLARE_CONFIG=
CVING_CLOUDFLARE_EXE=
CVING_MCP_REQUEST_TIMEOUT_SECONDS=45
CVING_MCP_DB_POOL_MIN=0
CVING_MCP_DB_POOL_MAX=6
CVING_MCP_MAX_ROWS=5000
CVING_MCP_LOG_MAX_BYTES=10485760
CVING_MCP_LOG_BACKUPS=5
# Optional dedicated read-only account (never put real secrets in this file).
CVING_MCP_ORACLE_USER=
CVING_MCP_ORACLE_PASSWORD=
