# Optional manual RMAN safety backup for CvingTrade25X Oracle 19c.
# Review archivelog status first. If the database is in NOARCHIVELOG mode, comment out the ARCHIVELOG section.

CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE SNAPSHOT CONTROLFILE NAME TO 'E:\DB_BACKUP_SAFETY\RMAN\snapcf_orcl.f';

RUN {
  ALLOCATE CHANNEL c1 DEVICE TYPE DISK FORMAT 'E:\DB_BACKUP_SAFETY\RMAN\%d_%T_%U.bkp';
  BACKUP AS COMPRESSED BACKUPSET DATABASE TAG 'CVINGTRADE25X_DB_SAFETY';
  BACKUP CURRENT CONTROLFILE FORMAT 'E:\DB_BACKUP_SAFETY\RMAN\CONTROL_%d_%T_%U.bkp' TAG 'CVINGTRADE25X_CTRL_SAFETY';
  SQL 'ALTER SYSTEM ARCHIVE LOG CURRENT';
  BACKUP AS COMPRESSED BACKUPSET ARCHIVELOG ALL NOT BACKED UP 1 TIMES FORMAT 'E:\DB_BACKUP_SAFETY\RMAN\ARCH_%d_%T_%U.bkp' TAG 'CVINGTRADE25X_ARCH_SAFETY';
  RELEASE CHANNEL c1;
}

LIST BACKUP SUMMARY;
REPORT OBSOLETE;